{
  "name": "zenstier",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"next dev -H 0.0.0.0 -p 3020\" \"pnpm worker:dev\"",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3020",
    "lint": "eslint",
    "dynsec:seed": "tsx scripts/seed-dynsec.ts",
    "dynsec:verify": "tsx scripts/verify-acl.ts",
    "worker": "tsx --conditions=react-server --tsconfig tsconfig.worker.json src/server/worker/main.ts",
    "worker:dev": "tsx watch --conditions=react-server --tsconfig tsconfig.worker.json src/server/worker/main.ts",
    "user:create": "tsx --conditions=react-server --tsconfig tsconfig.worker.json scripts/create-user.ts",
    "e2e:dispatch": "tsx --conditions=react-server --tsconfig tsconfig.worker.json scripts/e2e-dispatch.ts",
    "e2e:revoke": "tsx --conditions=react-server --tsconfig tsconfig.worker.json scripts/e2e-revoke.ts",
    "dev:web": "next dev -H 0.0.0.0 -p 3020",
    "start:all": "concurrently -n web,worker -c cyan,magenta \"next start -H 0.0.0.0 -p 3020\" \"pnpm worker\"",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "certs": "./infra/certs/gen-dev-ca.sh",
    "setup": "./scripts/bootstrap.sh",
    "agent:build": "make -C agent build-all",
    "rbac:verify": "tsx --conditions=react-server --tsconfig tsconfig.worker.json scripts/verify-rbac.ts",
    "e2e:broadcast": "tsx --conditions=react-server --tsconfig tsconfig.worker.json scripts/e2e-broadcast.ts",
    "dynsec:reconcile": "tsx --conditions=react-server --tsconfig tsconfig.worker.json scripts/reconcile-broker.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-table": "^9.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "cron-parser": "^5.10.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.45.0",
    "mqtt": "^5.15.2",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0"
}
