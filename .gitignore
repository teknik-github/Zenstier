# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must ship, or there is nothing to copy from.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated

# ── TLS material ────────────────────────────────────────────────────────────
# Dev certificates are generated locally by infra/certs/gen-dev-ca.sh.
# Private keys must never reach a repository, least of all a public one.
*.key
*.crt
*.srl
*.csr
infra/mosquitto/certs/
infra/mosquitto/data/
infra/mosquitto/log/

# ── Build artefacts ─────────────────────────────────────────────────────────
agent/dist/
agent/build/

# ── Local scratch ───────────────────────────────────────────────────────────
*.local
.claude/
