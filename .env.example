# Copy to .env and fill in. `./scripts/bootstrap.sh` generates this file for
# you with strong random secrets — prefer that over editing by hand.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=zenstier
# REQUIRED. Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=zenstier
DATABASE_URL="postgresql://zenstier:CHANGE_ME@localhost:5480/zenstier?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate one: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Leave AUTH_URL unset so the origin follows the request host: that lets the
# dashboard work on localhost AND a LAN address with one configuration.
# Set it only behind a proxy with a single fixed public URL.
#AUTH_URL=https://zenstier.example.com

# ── MQTT broker (Mosquitto) ─────────────────────────────────────────────────
MQTT_URL=mqtts://localhost:8883
MQTT_CA_FILE=./infra/mosquitto/certs/ca.crt

# Data plane: dispatches commands and ingests results. Cannot mint credentials.
MQTT_BACKEND_USERNAME=zenstier-server
MQTT_BACKEND_PASSWORD=

# Control plane: manages credentials. No access to application topics at all.
MQTT_PROVISIONER_USERNAME=zenstier-provisioner
MQTT_PROVISIONER_PASSWORD=

# Mosquitto's dynamic-security admin, created on the broker's first boot.
MQTT_ADMIN_USERNAME=admin
MQTT_ADMIN_PASSWORD=

# ── Redis (SSE bus + rate limiting) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6385

# ── Agent-facing settings ───────────────────────────────────────────────────
# The host agents dial. Must match a SAN on the broker certificate, so use the
# LAN IP or DNS name other machines can actually reach — not "localhost".
AGENT_MQTT_HOST=localhost
AGENT_MQTT_PORT=8883

# ── AI console (optional) ───────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Leave AI_API_KEY empty to disable the feature.
#   DeepSeek: https://api.deepseek.com          model deepseek-chat
#   OpenAI:   https://api.openai.com            model gpt-4o-mini
#   Ollama:   http://localhost:11434            model llama3.1
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_RATE_LIMIT_PER_HOUR=60

# ── Rate limiting ───────────────────────────────────────────────────────────
COMMAND_RATE_LIMIT_PER_MINUTE=30
